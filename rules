// ========== 可按需修改 ==========
const US_REGEX = /(🇺🇸|美国|美区|洛杉矶|硅谷|西雅图|纽约|芝加哥|达拉斯|旧金山|US\b|US-|【US】|United States|Los Angeles|San Jose|Seattle|New York|Chicago|Dallas|Silicon|USA)/i;
const JP_REGEX = /(🇯🇵|日本|日区|东京|大阪|京都|JP\b|JP-|【JP】|Japan|Tokyo|Osaka)/i;

const MANUAL_US = [];
const MANUAL_JP = [];

const EXTRA_BROKER_RULES = [
  // "DOMAIN,api5.futunn.com",
  // "IP-CIDR,119.91.244.0/23,no-resolve",
];

const G_US = "BROKER-US";
const G_JP = "BROKER-JP";
const G_OUT = "BROKER";
const G_GPT = "ChatGPT";
const G_CLAUDE = "Claude";

const MINE_GROUPS = new Set([G_US, G_JP, G_OUT, G_GPT, G_CLAUDE]);
const UI_ENTRY_GROUPS = ["GLOBAL", "节点选择", "Proxy", "PROXY"];
// ================================

function isGroup(config, name) {
  return (config["proxy-groups"] || []).some((g) => g.name === name);
}

function leafNames(config) {
  const set = new Set();
  (config.proxies || []).forEach((p) => p.name && set.add(p.name));
  (config["proxy-groups"] || []).forEach((g) => {
    (g.proxies || []).forEach((n) => {
      if (
        typeof n === "string" &&
        !["DIRECT", "REJECT", "GLOBAL"].includes(n) &&
        !isGroup(config, n)
      ) {
        set.add(n);
      }
    });
  });
  return [...set];
}

function membersFromNamedGroups(config, nameRe) {
  const out = [];
  for (const g of config["proxy-groups"] || []) {
    if (MINE_GROUPS.has(g.name)) continue;
    if (!nameRe.test(g.name || "")) continue;
    for (const n of g.proxies || []) {
      if (typeof n !== "string" || ["DIRECT", "REJECT", "GLOBAL"].includes(n))
        continue;
      if (isGroup(config, n)) continue;
      out.push(n);
    }
  }
  return [...new Set(out)];
}

function pick(list, re) {
  return [...new Set(list.filter((n) => re.test(n)))];
}

function buildMyBrokerGroups(config) {
  const leaves = leafNames(config);
  let us = MANUAL_US.length ? [...MANUAL_US] : pick(leaves, US_REGEX);
  let jp = MANUAL_JP.length ? [...MANUAL_JP] : pick(leaves, JP_REGEX);

  if (!us.length) {
    us = membersFromNamedGroups(
      config,
      /(🇺🇸|美国|美区|\bUS\b|United States|USA|洛杉矶|纽约)/i
    );
  }
  if (!jp.length) {
    jp = membersFromNamedGroups(
      config,
      /(🇯🇵|日本|日区|\bJP\b|Japan|东京|大阪)/i
    );
  }

  return [
    { name: G_US, type: "select", proxies: us.length ? us : ["DIRECT"] },
    { name: G_JP, type: "select", proxies: jp.length ? jp : ["DIRECT"] },
    { name: G_OUT, type: "select", proxies: ["DIRECT", G_US, G_JP] },
  ];
}

/** AI 组：默认走美国，其次日本，也可手选任意节点（OpenAI/Claude 不支持 CN/HK） */
function buildAiGroups(config) {
  const leaves = leafNames(config);
  const proxies = [G_US, G_JP].concat(leaves);
  return [
    { name: G_GPT, type: "select", proxies: [...proxies] },
    { name: G_CLAUDE, type: "select", proxies: [...proxies] },
  ];
}

/** 旧版能显示的关键：自建组放在 proxy-groups 最前面 */
function setupProxyGroups(config) {
  const myGroups = buildMyBrokerGroups(config).concat(buildAiGroups(config));
  const rest = (config["proxy-groups"] || []).filter((g) => {
    const n = (g.name || "").trim();
    return n && !MINE_GROUPS.has(n);
  });
  config["proxy-groups"] = myGroups.concat(rest);
}

/** FlClash：把 BROKER 挂到入口组，否则代理页可能不展示 */
function exposeGroupsInFlClashUI(config) {
  const inject = [G_OUT, G_US, G_JP, G_GPT, G_CLAUDE];
  for (const g of config["proxy-groups"] || []) {
    if (!UI_ENTRY_GROUPS.includes(g.name)) continue;
    if (!Array.isArray(g.proxies)) g.proxies = [];
    const rest = g.proxies.filter((p) => !inject.includes(p));
    g.proxies = inject.concat(rest);
  }
}

function isCnGeoRule(line) {
  const s = String(line).replace(/\s/g, "");
  return /^(GEOIP,CN|GEOSITE,cn|GEOIP,china)/i.test(s);
}

function buildBrokerBlock() {
  const head = [
    "DOMAIN-SUFFIX,futunn.com," + G_OUT,
    "DOMAIN-SUFFIX,futu.com," + G_OUT,
    "DOMAIN-SUFFIX,moomoo.com," + G_OUT,
    "DOMAIN-SUFFIX,futuhk.com," + G_OUT,
    "DOMAIN-SUFFIX,futuhn.com," + G_OUT,
  ];
  const extra = (EXTRA_BROKER_RULES || []).map((r) => {
    const s = String(r).trim();
    if (!s) return null;
    const parts = s.split(",");
    return parts.length >= 3 ? s : s + "," + G_OUT;
  }).filter(Boolean);
  return extra.concat(head).concat(["RULE-SET,Broker," + G_OUT]);
}

function buildAiBlock() {
  return [
    "DOMAIN-SUFFIX,openai.com," + G_GPT,
    "DOMAIN-SUFFIX,chatgpt.com," + G_GPT,
    "DOMAIN-SUFFIX,chat.com," + G_GPT,
    "DOMAIN-SUFFIX,sora.com," + G_GPT,
    "DOMAIN-SUFFIX,oaistatic.com," + G_GPT,
    "DOMAIN-SUFFIX,oaiusercontent.com," + G_GPT,
    "DOMAIN-KEYWORD,openai," + G_GPT,
    "RULE-SET,AI-ChatGPT," + G_GPT,
    "DOMAIN-SUFFIX,anthropic.com," + G_CLAUDE,
    "DOMAIN-SUFFIX,claude.ai," + G_CLAUDE,
    "DOMAIN-SUFFIX,claude.com," + G_CLAUDE,
    "DOMAIN-SUFFIX,claudeusercontent.com," + G_CLAUDE,
    "DOMAIN-SUFFIX,clau.de," + G_CLAUDE,
    "RULE-SET,AI-Claude," + G_CLAUDE,
  ];
}

function reorderRulesForBroker(rules) {
  rules = Array.isArray(rules) ? rules : [];
  const brokerBlock = buildBrokerBlock().concat(buildAiBlock());

  const body = rules.filter((r) => !/^RULE-SET,(Broker|AI-ChatGPT|AI-Claude),/.test(String(r)));
  const cnGeo = body.filter(isCnGeoRule);
  const middle = body.filter((r) => !isCnGeoRule(r));
  const withoutMatch = middle.filter((r) => !String(r).startsWith("MATCH,"));
  const matchRules = middle.filter((r) => String(r).startsWith("MATCH,"));

  return brokerBlock.concat(withoutMatch).concat(cnGeo).concat(matchRules);
}

function main(config) {
  config = config || {};
  config["proxy-groups"] = config["proxy-groups"] || [];
  config.rules = config.rules || [];

  config["rule-providers"] = Object.assign({}, config["rule-providers"], {
    Broker: {
      type: "http",
      behavior: "classical",
      format: "yaml",
      url: "https://raw.githubusercontent.com/forecho/broker-rules/master/rule/Clash/Broker.yaml",
      path: "./ruleset/Broker.yaml",
      interval: 86400,
    },
    "AI-ChatGPT": {
      type: "http",
      behavior: "classical",
      format: "yaml",
      url: "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/OpenAI/OpenAI.yaml",
      path: "./ruleset/AI-ChatGPT.yaml",
      interval: 86400,
    },
    "AI-Claude": {
      type: "http",
      behavior: "classical",
      format: "yaml",
      url: "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Claude/Claude.yaml",
      path: "./ruleset/AI-Claude.yaml",
      interval: 86400,
    },
  });

  setupProxyGroups(config);
  exposeGroupsInFlClashUI(config);

  try {
    config.rules = reorderRulesForBroker(config.rules);
  } catch (e) {
    // 规则重排失败也不影响策略组注入
    config.rules = buildBrokerBlock().concat(buildAiBlock()).concat(config.rules);
  }

  return config;
}
